# 统一编辑器行为（VS Code / CLion / Vim 自动读取），与 .clang-format 对齐
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{py,cmake,txt}]
indent_size = 4

[*.{json,yml,yaml,ld,svd}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
