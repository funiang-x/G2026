{
    // ========================================================================
    //  工作区设置 —— 面向 AI 辅助嵌入式开发的 VS Code 环境
    //
    //  ⚠️ 本文件在**根目录**的 .vscode/ 下，是给"打开整个 G2026 工程"用的那份。
    //     VS Code **只读你打开的那个目录的 .vscode/**（不递归）—— 所以
    //     `firmware/.vscode/` 里还有一份给"只打开固件子目录"用的。
    //     两边是**故意的双份**（`firmware/Tools/derive.py` 派生出的独立固件
    //     工程要能单独打开、自带完整配置），改的时候要同步。
    //     ⚠️ 根目录这份是从模板 `projects/templet/.vscode/` 抄来的，
    //        除了下面标了「G2026 专有」的几行，其余应与模板保持一致。
    //
    //  布局：根目录 = 文档/硬件/工具，固件全在 `firmware/`。
    //        所有指向固件的路径都要带 `firmware/` 前缀。
    // ========================================================================

    // ---------- CMake 集成 ----------
    // 强制用 CMakePresets.json 里的预设，避免 CMake Tools 自己乱猜生成器
    // （猜成 Visual Studio 就会编译失败，且报错难以理解）
    "cmake.useCMakePresets": "always",
    "cmake.sourceDirectory": "${workspaceFolder}/firmware",
    // 打开工程就自动 configure：省掉"点一次配置"。工具链没装时会当场报错 ——
    // 那是**想要的**（fail fast）。想安静浏览就改成 false。
    "cmake.configureOnOpen": true,
    // ⚠️ 用预设时这条其实被忽略（CMake Tools 按预设的 binaryDir 走）；
    //    留着是为了"万一哪天不用预设了"也指向 firmware/build 而不是根 build。
    "cmake.buildDirectory": "${workspaceFolder}/firmware/build/${presetName}",
    "cmake.generator": "Ninja",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // ---------- 文件关联（.ld / .s 默认是纯文本，关联后才有语法高亮）----------
    //  ⚠️ 语言 ID 必须与扩展注册的 id **逐字一致**，写错是**静默无效**
    //     （不报错、不高亮，只有对比才知道）。这两个值是对着扩展的
    //     package.json 核过的，别凭印象改：
    //       ZixuanWang.linkerscript → id "linkerscript"（不是 "linker-script"）
    //       dan-c-underwood.arm     → id "arm"（.s / .S / .asm / .sx）
    "files.associations": {
        "*.ld": "linkerscript",
        "*.s": "arm",
        "*.S": "arm",
        "*.h": "c",
        "CMakeLists.txt": "cmake",
        "*.cmake": "cmake"
    },

    // ---------- 工作区减负：资源管理器只显示"你要改的代码" ----------
    //
    // 判据只有一条：**这个文件是人写的，还是衍生的？**
    //   人写的（Task/ Device/ Operation/ Common/ Test/ Tools/ 以及 Core/ 里的
    //   USER CODE、**整个 docs/**）→ 显示
    //   衍生的（构建产物、vendored 依赖、AI 记忆）→ 隐藏
    //
    // ★ `docs/` 一律保留可见（用户明确要求："docs 我在 vscode 要看的"）
    //   —— 文档是"规范"的一部分，不算"与关键代码无关"。
    //
    // ⚠️ files.exclude **只影响显示** —— 不删文件、不影响构建、不影响
    //    IntelliSense 与"转到定义"（语言服务器读的是 compile_commands.json，
    //    不是文件树）。想临时看被隐藏的东西：把对应行改成 false 即可。
    "files.exclude": {
        // ---- 构建产物（`**/build` 同时覆盖 firmware/build 与 Test 的 host 构建）----
        "**/build": true,
        "**/.cache": true,

        // ---- CubeMX 生成物：隐藏 ----
        //      ⚠️ 不要手改（docs/01 规矩 4）：由 CubeMX 重新生成时会被覆盖。
        "firmware/Drivers": true,
        // ★ 2026-10-06：`firmware/Middlewares` 不再隐藏（用户要求看到 LVGL / FreeRTOS）。
        //   可见：LVGL（lv_conf.h + src/）、Third_Party/FreeRTOS、RTT。
        //   ⚠️ 可见 != 能改：Third_Party/FreeRTOS 是 CubeMX 生成物、RTT 是 vendor 的，
        //      重生成 / 升级会被覆盖。本工程要动的只有 LVGL/lv_conf.h。

        // ---- 工作区治理：AI 的临时产物 / 历史证据 / 门禁状态 ----
        "_archive": true,
        "_work": true,
        ".ai-skills-state": true,

        // ---- AI 助手的记忆与备份：不属于工程代码 ----
        ".workbuddy": true,
        ".workbuddy-ai": true,
        ".codebuddy": true,
        ".trae": true,
        ".easyeda": true,

        // ---- G2026 专有：外部资料包与抽取数据（体积大、且不是"你要改的代码"）----
        //      用途与证据清单见 AGENTS.md 与 _archive/MANIFEST.md。
        "docs/立创·梁山派·天空星STM32F407VET6开发板资料（标准库）": true,
        "docs/TK035F5687_9629_整理资料_(含SPI及并口版)": true,
        "hardware/data": true
    },

    // 搜索范围：只排除**纯衍生**的东西。
    // ★ Drivers/ Middlewares/ docs/ **仍然可搜** —— 查 HAL 实现细节、
    //   FreeRTOS 内部行为、当年为什么这么决策时很有用。别把它们加进来。
    "search.exclude": {
        "**/build": true,
        "**/.git": true,
        ".workbuddy": true,
        ".workbuddy-ai": true
    },

    // 文件监视：把大目录排除。build/ 文件多，不排除会占满 watch 句柄，
    // 表现是"改了文件但 VS Code 不刷新 / 保存变慢"。
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "firmware/Drivers/**": true,
        "firmware/Middlewares/**": true,
        ".workbuddy/**": true,
        ".workbuddy-ai/**": true
    },

    // ---------- 文件嵌套：把 .h 折到同名 .c 下面 ----------
    // 目的：Inc/ Src/ 两层目录点起来烦，但**目录结构不动**（改了会牵动 CMake、
    // 脚本、include 路径）。这里让资源管理器把 bsp_log.h 折进 bsp_log.c，
    // 看起来就是一个文件，点一下展开。零风险 —— 只影响显示。
    // 想看到全部散文件：把 explorer.fileNesting.enabled 改成 false。
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.c": "${capture}.h, ${capture}_*.h",
        "*.h": "${capture}.c, ${capture}_*.c",
        "CMakeLists.txt": "CMakePresets.json, *.cmake"
    },

    // ---------- 编辑器规范（与 .clang-format / .editorconfig 对齐）----------
    "editor.formatOnSave": true,
    "editor.rulers": [
        88,
        100
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "[yaml]": {
        "editor.tabSize": 2
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // ---------- cortex-debug：把工具链路径集中在这里 ----------
    // 改机器/升级 J-Link 只改这两行，launch.json 里引用 ${config:cortex-debug.*}
    "cortex-debug.armToolchainPath": "C:/Program Files/Compiler/arm-gnu-toolchain-15.2.rel1-mingw-w64-i686-arm-none-eabi/bin",
    "cortex-debug.JLinkGDBServerPath": "C:/Program Files/SEGGER/JLink_V936/JLinkGDBServerCL.exe",

    // ---------- 终端 ----------
    // Windows 下默认用 Git Bash：工程里所有命令（cmake/ninja/python）都按
    // POSIX 写法给出，在 PowerShell 里复制粘贴会因为路径与转义差异出问题。
    // ⚠️ 终端落在**工程根**。固件命令要先 `cd firmware`（或直接用上面的任务，
    //    它们的 cwd 已经指到 firmware 了）。
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.cwd": "${workspaceFolder}"
}
